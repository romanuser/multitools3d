# Copie este arquivo pra ".env.local" e preencha com os valores do seu
# projeto Supabase (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://pcdkswksvvljorcvwjye.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_kOCyoDykogxkD9OW9Syfsg_E4j4vUgw
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_kOCyoDykogxkD9OW9Syfsg_E4j4vUgw

# NUNCA leve essa chave pro navegador nem pra nenhum arquivo com "use client".
# Ela só é usada em rotas de servidor (ex: o webhook da InfinitePay), porque
# esse webhook é chamado pela InfinitePay direto, sem ninguém logado.
# Pegue em: Supabase -> Project Settings -> API Keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# Sua InfiniteTag (o @seu-usuario da InfinitePay), sem o "$" na frente.
# Usada pra cobrar as assinaturas VIP do Multiferramenta 3D.
INFINITEPAY_HANDLE=

# URL pública onde o site está rodando. Em localhost, deixe como está.
# Quando publicar de verdade (domínio próprio), troque para a URL real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mail de boas-vindas (painel Admin -> botão "Enviar boas-vindas").
# Crie uma conta grátis em resend.com e gere uma chave em resend.com/api-keys.
RESEND_API_KEY=

# Sem verificar um domínio, o Resend só entrega pro e-mail da SUA própria
# conta — pra mandar pra qualquer cliente cadastrado, verifique um domínio
# em resend.com/domains e troque o remetente abaixo pra esse domínio.
# Formato: "Nome <endereco@seudominio.com>". Deixe em branco pra usar o
# remetente de teste do Resend (onboarding@resend.dev).
RESEND_FROM_EMAIL=